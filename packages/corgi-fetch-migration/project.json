{
  "name": "corgi-fetch-migration",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/corgi-fetch-migration/src",
  "projectType": "application",
  "tags": ["scope:tooling"],
  "targets": {
    "plan": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --experimental-strip-types src/cli.ts plan"
      }
    },
    "schema:bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --experimental-strip-types src/cli.ts bootstrap"
      }
    },
    "apply": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --experimental-strip-types src/cli.ts apply"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --experimental-strip-types src/cli.ts verify"
      }
    },
    "rollback": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --experimental-strip-types src/cli.ts rollback"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "node --experimental-strip-types --test test/*.test.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsgo -p tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "npx oxlint -c .oxlintrc.json src test && npx oxfmt --check src test"
      }
    }
  }
}
